[Unit]
Description=vigosk hub (receives metrics from vigosk-agents)
Documentation=https://github.com/gabegaglio/vigosk/blob/main/docs/MULTINODE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# @SHARE@ is replaced with the vigosk install directory by `vigosk hub enable`.
ExecStart=/usr/bin/python3 @SHARE@/fleet.py serve
Environment=VIGOSK_HUB_LISTEN=@LISTEN@
Environment=VIGOSK_HUB_ADVERTISE=@ADVERTISE@
# Certificate, key and the node list live here (mode 700).
StateDirectory=vigosk-hub
StateDirectoryMode=0700
# Control socket for the dashboard + `vigosk node` (root and the hub only).
RuntimeDirectory=vigosk-hub
RuntimeDirectoryMode=0750
Restart=always
RestartSec=5

# ── Sandbox ────────────────────────────────────────────────────────
# The hub is the only vigosk component that listens on the network, so
# it runs as a throwaway unprivileged user with no capabilities and a
# read-only view of the system (it can only write its own state dir).
DynamicUser=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
CPUQuota=25%
MemoryMax=128M
TasksMax=256

[Install]
WantedBy=multi-user.target
