# Old backups kept locally during the vterm → vigosk rebrand. Not history.
*.bak
*.bak2

# Python
__pycache__/
*.pyc
*.pyo

# Editor / OS noise
.DS_Store
*.swp
*.swo

# Logs that occasionally land in the source tree
*.log

# Release build output (CI writes here)
/dist/

# Runtime UI config (ping targets + container watch list). Host-specific
# state written by POST /api/config — not source.
/vigosk-config.json

# Host-specific kiosk monitor on/off helpers — not portable across
# users (assume specific hardware / xset / vbetool behavior).
screen-off*
screen-on*
screen-keepalive*
